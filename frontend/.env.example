# Salin file ini menjadi `.env` kalau butuh ubah default:
#   cp .env.example .env
# Tanpa `.env` pun frontend tetap jalan karena kode punya fallback
# ke nilai yang sama seperti di bawah ini.

# Base URL API Laravel. Default "/api" memakai proxy Vite ke http://127.0.0.1:8000.
VITE_API_URL=/api

# Kunci Reverb HARUS sama dengan REVERB_APP_KEY di backend/.env.
VITE_REVERB_APP_KEY=flowspace
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
